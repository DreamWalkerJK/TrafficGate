<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <HeadOutlet />
    <style>
        :root {
            --ink: #162338;
            --muted: #607086;
            --line: #d7e0ea;
            --paper: #f5f8fb;
            --panel: #ffffff;
            --navy: #12304d;
            --blue: #1e6fa8;
            --blue-soft: #e8f2f8;
            --green: #26735d;
            --amber: #9b5d16;
            --red: #a33e4d;
            color-scheme: light;
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; background: var(--paper); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; }
        body { font-size: 15px; line-height: 1.5; }
        a { color: var(--blue); }
        button, input, textarea, select { font: inherit; }
        button { cursor: pointer; }
        :focus-visible { outline: 3px solid #8bc6ec; outline-offset: 2px; }
        .shell { min-height: 100vh; }
        .topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 20px clamp(20px, 5vw, 72px); background: var(--navy); color: #f7fbff; border-bottom: 4px solid #3f9bc7; }
        .brand { display: flex; align-items: center; gap: 12px; letter-spacing: .02em; }
        .brand-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 2px solid #8ed2ed; color: #8ed2ed; font-weight: 800; font-size: 13px; }
        .brand-name { font-weight: 720; font-size: 17px; }
        .brand-subtitle { color: #b8cddd; font-size: 13px; margin-left: 4px; }
        .topbar-meta { text-align: right; color: #c5d5e3; font-size: 12px; }
        .topbar-meta strong { display: block; color: #fff; font-size: 14px; font-weight: 650; }
        .workspace { width: min(1420px, calc(100% - 40px)); margin: 0 auto; padding: 40px 0 64px; }
        .intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
        .eyebrow { color: var(--blue); font-size: 12px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }
        h1, h2, h3 { margin: 0; letter-spacing: -.025em; }
        h1 { font-size: clamp(28px, 4vw, 40px); line-height: 1.05; }
        h2 { font-size: 20px; }
        h3 { font-size: 15px; }
        .intro p { max-width: 650px; margin: 10px 0 0; color: var(--muted); }
        .identity { color: var(--muted); font-size: 13px; text-align: right; white-space: nowrap; }
        .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 30px; }
        .stat { background: var(--panel); border: 1px solid var(--line); padding: 17px 18px; }
        .stat-label { color: var(--muted); font-size: 12px; }
        .stat-value { display: block; margin-top: 5px; color: var(--navy); font-size: 25px; font-weight: 720; letter-spacing: -.04em; }
        .stat-note { color: var(--muted); font-size: 12px; }
        .panel { background: var(--panel); border: 1px solid var(--line); margin: 0 0 18px; }
        .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 20px; border-bottom: 1px solid var(--line); }
        .panel-heading p { margin: 3px 0 0; color: var(--muted); font-size: 13px; }
        .panel-body { padding: 20px; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; min-width: 680px; }
        th { color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .07em; text-align: left; text-transform: uppercase; white-space: nowrap; }
        th, td { padding: 12px 14px; border-bottom: 1px solid #e7edf3; vertical-align: top; }
        tr:last-child td { border-bottom: 0; }
        td { color: #25354a; font-size: 13px; }
        code, .mono { font-family: "Cascadia Code", "SFMono-Regular", Consolas, monospace; font-size: 12px; }
        code { color: #174d72; background: #eef5f9; padding: 2px 5px; }
        .muted { color: var(--muted); }
        .pill { display: inline-flex; align-items: center; gap: 5px; padding: 3px 8px; border-radius: 99px; background: var(--blue-soft); color: #1b5c87; font-size: 12px; font-weight: 650; }
        .pill.ok { background: #e8f4ef; color: var(--green); }
        .pill.warn { background: #fff3df; color: var(--amber); }
        .pill.error { background: #fbecef; color: var(--red); }
        .form-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 18px; align-items: start; }
        label { display: block; color: #31465d; font-size: 13px; font-weight: 650; margin-bottom: 7px; }
        textarea, input[type=text], input[type=number] { width: 100%; color: var(--ink); background: #fbfdff; border: 1px solid #bdcad7; border-radius: 2px; padding: 10px 11px; }
        textarea { min-height: 360px; resize: vertical; line-height: 1.45; }
        input[readonly] { color: var(--muted); background: #f1f5f8; }
        .field-help { margin-top: 6px; color: var(--muted); font-size: 12px; }
        .action-column { display: flex; flex-direction: column; gap: 10px; }
        .button-row { display: flex; flex-wrap: wrap; gap: 9px; align-items: center; }
        .button { border: 1px solid #1a5e8a; border-radius: 2px; padding: 9px 14px; background: var(--blue); color: #fff; font-weight: 700; }
        .button:hover { background: #185a87; }
        .button.secondary { border-color: #aebdca; background: #fff; color: #294056; }
        .button.secondary:hover { background: #f1f6f9; }
        .button.danger { border-color: #9e3c4b; background: #a33e4d; }
        .button.small { padding: 6px 10px; font-size: 12px; }
        .notice { border-left: 4px solid var(--blue); background: #eef6fb; color: #244a64; padding: 11px 13px; margin: 0 0 16px; }
        .notice.success { border-color: var(--green); background: #edf7f2; color: #245a49; }
        .notice.error { border-color: var(--red); background: #fff0f2; color: #80313e; }
        .notice ul { margin: 5px 0 0 18px; padding: 0; }
        .diff-list { margin: 12px 0 0; padding: 0; list-style: none; border: 1px solid var(--line); }
        .diff-list li { display: flex; gap: 12px; padding: 9px 12px; border-bottom: 1px solid #e7edf3; }
        .diff-list li:last-child { border-bottom: 0; }
        .history-table td { font-size: 12px; }
        .failure { color: var(--red); }
        .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
        .footer-note { color: var(--muted); font-size: 12px; margin-top: 12px; }
        @@media (max-width: 850px) {
            .topbar, .intro { align-items: flex-start; flex-direction: column; }
            .topbar-meta, .identity { text-align: left; }
            .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .form-grid { grid-template-columns: 1fr; }
        }
        @@media (max-width: 500px) {
            .workspace { width: min(100% - 24px, 1420px); padding-top: 26px; }
            .grid { grid-template-columns: 1fr 1fr; gap: 8px; }
            .stat { padding: 13px; }
            .panel-heading, .panel-body { padding: 15px; }
        }
        @@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; } }
    </style>
</head>
<body>
    <Routes />
</body>
</html>
